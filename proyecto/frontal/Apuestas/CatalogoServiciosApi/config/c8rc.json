{
  "include": [
    "artifacts/compilado/src/**",
    "src/**",
    "artifacts/compilado/scripts/divergencias/comparar.js",
    "artifacts/compilado/scripts/divergencias/extraer.js",
    "scripts/divergencias/comparar.ts",
    "scripts/divergencias/extraer.ts",
    "artifacts/compilado/scripts/inicializar/generar.js",
    "scripts/inicializar/generar.ts"
  ],
  "exclude": ["src/index.ts"],
  "exclude-after-remap": true,
  "reporter": ["text", "html", "cobertura", "lcov"],
  "reports-dir": "artifacts/cobertura",
  "check-coverage": true,
  "lines": 90,
  "branches": 90,
  "functions": 90,
  "statements": 90
}
