{
  "default": {
    "paths": [
      "node_modules/@apuestas-deportivas/catalogo-servicios-api-pruebas/features/**/*.feature",
      "tests/sistema/**/*.feature"
    ],
    "import": ["tests/sistema/soporte/**/*.ts", "tests/sistema/pasos/**/*.ts"],
    "format": [
      "progress",
      "html:artifacts/informes/cucumber.html",
      "junit:artifacts/informes/junit/sistema.xml"
    ]
  },
  "integracion": {
    "paths": [
      "node_modules/@apuestas-deportivas/catalogo-servicios-api-pruebas/features/**/*.feature",
      "tests/sistema/**/*.feature"
    ],
    "import": ["tests/sistema/soporte/**/*.ts", "tests/sistema/pasos/**/*.ts"],
    "format": [
      "progress",
      "html:artifacts/informes/integracion.html",
      "junit:artifacts/informes/junit/integracion.xml"
    ]
  }
}
