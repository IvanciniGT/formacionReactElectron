<?xml version="1.0" encoding="utf-8"?>
<!--
  Los paquetes propios (Comun.*, Apuestas.*, Jugadores.*, Operadores.*) se bajan del registro de GitLab;
  todo lo demás, de nuget.org. La asignación impide que un paquete con el mismo nombre
  publicado en nuget.org suplante a uno nuestro.

  Las credenciales NO van aquí. En el pipeline las añade el job con CI_JOB_TOKEN; en
  local, cada uno en su NuGet.Config de usuario para el origen "gitlab-apuestas".
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- El endpoint NuGet de grupo solo admite el id numérico (41 = apuestas-deportivas), no la ruta. -->
    <add key="gitlab-apuestas" value="https://gitlab.ivanosuna.com/api/v4/groups/41/-/packages/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="gitlab-apuestas">
      <package pattern="Comun.*" />
      <package pattern="Apuestas.*" />
      <package pattern="Jugadores.*" />
      <package pattern="Operadores.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
