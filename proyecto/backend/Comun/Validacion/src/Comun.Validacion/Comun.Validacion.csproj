<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- VersionPrefix solo vale para la primera publicación, cuando aún no hay ninguna
       versión aprobada: a partir de ahí la calcula el pipeline desde CHANGELOG.md. -->
  <PropertyGroup>
    <PackageId>Comun.Validacion</PackageId>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Iván Osuna Ayuste</Authors>
    <Description>Validación inyectable por DI para cualquier capa y dominio, sobre DataAnnotations.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
  </ItemGroup>

</Project>
